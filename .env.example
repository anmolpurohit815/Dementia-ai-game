# MindCare Database Configuration
# ---------------------------------------------
# Choose database driver: 'sqlite' or 'mysql'
DB_TYPE=sqlite

# SQLite Configuration (Used when DB_TYPE=sqlite or if MySQL is unreachable)
SQLITE_DB=mindcare.db

# MySQL Configuration (Compatible with MySQL Workbench 8.0+)
# Set DB_TYPE=mysql to enable MySQL mode
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mindcare_db
